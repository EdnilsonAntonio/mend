# Copy to dashboard/.env.local (from the repo root):
#   cp dashboard/.env.local.example dashboard/.env.local
#
# Next.js loads .env.local automatically for `next dev`, `next build`, and
# `next start`. No `export` and no `source` step is needed, in any terminal.
# Use the same DATABASE_URL as the repository root .env.
#
# If you use direnv, this file is optional: a DATABASE_URL already in the
# environment takes priority and Next.js will not overwrite it.

DATABASE_URL=postgres://postgres:mend@localhost:5433/mend
