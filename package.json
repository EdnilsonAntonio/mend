{
  "type": "module",
  "name": "self-healing-e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing Playwright E2E tests: an agent that repairs selector drift and verifies every fix by re-execution.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start:app": "node app-under-test/server.mjs",
    "test:e2e": "playwright test",
    "test:tools": "playwright test --config=playwright.tools.config.ts",
    "test:db": "playwright test --config=playwright.db.config.ts",
    "test:runner": "playwright test --config=playwright.runner.config.ts",
    "typecheck": "tsc --noEmit",
    "break:on": "node breakage/apply.mjs on",
    "break:off": "node breakage/apply.mjs off",
    "break:status": "node breakage/apply.mjs status",
    "tool:dom-snapshot": "tsx agent/tools/cli/get-dom-snapshot.cli.ts",
    "tool:query-selector": "tsx agent/tools/cli/query-selector.cli.ts",
    "tool:run-single-test": "tsx agent/tools/cli/run-single-test.cli.ts",
    "classify:failures": "tsx agent/classifier/cli/classify-failures.cli.ts",
    "heal:one": "tsx agent/loop/cli/heal.cli.ts",
    "heal:all": "tsx agent/loop/cli/heal-all.cli.ts",
    "heal": "tsx runner/cli/heal-run.cli.ts",
    "db:migrate": "tsx db/cli/migrate.cli.ts",
    "db:migrate:status": "tsx db/cli/migrate.cli.ts --status",
    "test:dashboard": "playwright test --config=playwright.dashboard.config.ts",
    "dashboard:install": "npm --prefix dashboard install",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "pg": "^8.23.0"
  }
}
