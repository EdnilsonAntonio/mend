{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.tools.config.ts",
    "playwright.verify.config.ts",
    "playwright.db.config.ts",
    "playwright.runner.config.ts",
    "playwright.dashboard.config.ts",
    "playwright.metrics.config.ts",
    "playwright.scripts.config.ts",
    "tests/**/*.ts",
    "agent/**/*.ts",
    "db/**/*.ts",
    "runner/**/*.ts",
    "dashboard/lib/**/*.ts",
    "dashboard/__tests__/**/*.ts",
    "metrics/**/*.ts",
    "scripts/**/*.ts"
  ]
}
