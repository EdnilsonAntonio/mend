# Copy to .env and fill in. Every `npm run` script that needs these loads this
# file automatically (scripts/with-env.mjs) — no `source` step required.
# With direnv installed, `direnv allow` also exports them into your shell.
# The dashboard reads dashboard/.env.local instead — see dashboard/README.md.

DATABASE_URL=postgres://postgres:mend@localhost:5433/mend
OPENAI_API_KEY=sk-your-key-here

# Optional — required only for `npm run heal` to open pull requests for
# high-confidence fixes. See runner/README.md.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
